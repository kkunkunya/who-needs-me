{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhoNeedsMe",
  "version": "0.1.0",
  "identifier": "dev.whoneedsme.app",
  "build": {
    "beforeDevCommand": "npm run build:ui",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WhoNeedsMe · Session Debug",
        "width": 620,
        "height": 620,
        "minWidth": 380,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
